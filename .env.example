# ========================================================
# Sahayak AI - Environment Variables Template
# ========================================================
# IMPORTANT:
# - NEVER put real API keys in this template or in git!
# - Copy this file to .env.local for local development.
# - On Vercel, configure these under Project Settings -> Environment Variables.
# ========================================================

# Google Gemini API Key (Server-side ONLY; never expose as VITE_*)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model Identifier (Default: gemini-1.5-flash)
# Supported options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Supabase Authentication & Database (Client-side)
# Obtain from Supabase Project Settings -> API: https://supabase.com/dashboard
VITE_SUPABASE_URL= https://oursivnuxjwduqihzyya.supabase.co
